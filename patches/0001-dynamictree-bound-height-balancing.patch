+    /// <summary>
+    /// Upper bound on the rotations a single <see cref="RestoreHeightBalanceWithoutIncreasingCost"/>
+    /// call may apply.
+    /// </summary>
+    /// <remarks>
+    /// Well-formed trees settle far below this limit. The budget exists so that cost-neutral
+    /// rotations cannot trade places indefinitely: leftover imbalance is repaired by the next
+    /// tree update, which is preferable to an unbounded descent.
+    /// </remarks>
+    private const int MaxHeightBalanceRotations = 64;
+
     private int RestoreHeightBalanceWithoutIncreasingCost(int node)
+    {
+        // A newly inserted leaf may have been paired with an arbitrarily tall subtree.
+        // In that case one rotation balances the new root but leaves the old root skewed.
+        // The demoted node is therefore re-balanced before the new subtree root is checked
+        // again, exactly as the original recursion did.
+        //
+        // That recursion is expressed here as an explicit stack instead of a recursive call:
+        // it had no termination guarantee. Two topologies with the same merged surface both pass
+        // IsAcceptedHeightRotation, so a node and its promoted child can rotate back and forth
+        // forever. In double precision builds this is reachable with ten rigid bodies and one
+        // step, overflowing the stack inside World.Step.
+        Span<int> pending = stackalloc int[MaxHeightBalanceRotations + 1];
+        int top = 0;
+        int subtreeRoot = node;
+        int rotations = 0;
+
+        pending[top++] = node;
+
+        while (top > 0 && rotations < MaxHeightBalanceRotations)
+        {
+            int current = pending[--top];
+
+            if (nodes[current].IsLeaf) continue;
+
+            // Rotations inside this subtree may have changed the children since it was last seen.
+            RefitNode(current);
+
+            if (!TryHeightBalanceRotation(current, out int promoted)) continue;
+
+            rotations++;
+            subtreeRoot = promoted;
+
+            // LIFO: the demoted node is handled before the promoted root.
+            pending[top++] = promoted;
+            pending[top++] = current;
+        }
+
+        return subtreeRoot;
+    }
