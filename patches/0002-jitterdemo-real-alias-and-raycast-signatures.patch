diff --git a/src/JitterDemo/GlobalUsings.cs b/src/JitterDemo/GlobalUsings.cs
new file mode 100644
index 00000000..e9d8b90b
--- /dev/null
+++ b/src/JitterDemo/GlobalUsings.cs
@@ -0,0 +1,19 @@
+/*
+ * Jitter2 Physics Library
+ * (c) Thorben Linneweber and contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+// Mirrors Jitter2/Precision.cs. The demo is built with the same switch as the engine
+// (dotnet build -c Release -p:DoublePrecision=true), so "Real" always matches the engine.
+#if USE_DOUBLE_PRECISION
+
+global using Real = System.Double;
+global using MathR = System.Math;
+
+#else
+
+global using Real = System.Single;
+global using MathR = System.MathF;
+
+#endif
diff --git a/src/JitterDemo/JitterDemo.csproj b/src/JitterDemo/JitterDemo.csproj
index 2cee85ba..0aaf2604 100644
--- a/src/JitterDemo/JitterDemo.csproj
+++ b/src/JitterDemo/JitterDemo.csproj
@@ -44,6 +44,12 @@
       <PackageReference Include="VellumUI" Version="1.1.0" />
     </ItemGroup>
 
+    <!-- Mirror Jitter2: -p:DoublePrecision=true has to reach this project too, otherwise the
+         demos keep using float literals while the engine hands out doubles. -->
+    <PropertyGroup Condition="'$(DoublePrecision)' == 'true'">
+      <DefineConstants>$(DefineConstants);USE_DOUBLE_PRECISION</DefineConstants>
+    </PropertyGroup>
+
     <PropertyGroup>
         <OutputType>Exe</OutputType>
         <TargetFramework>net10.0</TargetFramework>
